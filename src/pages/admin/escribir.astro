---
import AdminLayout from '../../layouts/AdminLayout.astro';
import EditorWYSIWYG from '../../components/admin/EditorWYSIWYG';
import TagSelector from '../../components/admin/TagSelector';
---
<AdminLayout title="Write Post">
  <h1 style="margin-bottom: 2rem;">Write a New Post</h1>
  
  <form method="POST" action="/api/posts/create" style="display: flex; flex-direction: column; gap: 1.5rem;">
    <div>
      <label style="display: block; font-weight: bold; margin-bottom: 0.5rem;">Title</label>
      <input type="text" name="title" style="width: 100%; padding: 0.75rem; font-size: 1.2rem; border: 1px solid #ccc; border-radius: 4px;" placeholder="Post Title" required />
    </div>
    
    <div>
      <label style="display: block; font-weight: bold; margin-bottom: 0.5rem;">Content</label>
      <!-- React Island -->
      <EditorWYSIWYG client:only="react" />
    </div>

    <div>
      <label style="display: block; font-weight: bold; margin-bottom: 0.5rem;">Tags</label>
      <TagSelector client:load />
    </div>
    
    <div style="margin-top: 1rem;">
      <button type="submit" style="padding: 0.75rem 2rem; background: #111; color: white; font-weight: bold; border: none; border-radius: 4px; cursor: pointer; font-size: 1rem;">
        Publish Post
      </button>
    </div>
  </form>
</AdminLayout>
