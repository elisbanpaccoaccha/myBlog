---
import BaseLayout from '../layouts/BaseLayout.astro';
import { lucia } from '../lib/lucia';
import { actions, isInputError } from 'astro:actions';

// Si ya tiene sesión válida, redirigir al dashboard
const sessionId = Astro.cookies.get(lucia.sessionCookieName)?.value;
if (sessionId) {
  const { session } = await lucia.validateSession(sessionId);
  if (session) return Astro.redirect('/studio');
}
---
<BaseLayout title="Registro — toBlog">
  <div class="login-wrapper">
    <div class="login-card">

      <h1 class="login-title">Crear una cuenta</h1>
      <p class="login-subtitle">Únete a nuestra comunidad.</p>

      <div class="error-container">
        <div id="err-general" class="login-error" role="alert"></div>
      </div>

      <form id="registerForm" class="login-form">
        <div class="form-group">
          <label for="username">Usuario</label>
          <input
            id="username"
            type="text"
            name="username"
            autocomplete="username"
            placeholder="tu_usuario"
            required
            minlength="3"
            maxlength="20"
          />
          <span id="err-username" class="field-error"></span>
        </div>
        <div class="form-group">
          <label for="email">Correo Electrónico</label>
          <input
            id="email"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="hola@ejemplo.com"
            required
          />
          <span id="err-email" class="field-error"></span>
        </div>
        <div class="form-group">
          <label for="password">Contraseña</label>
          <div class="password-wrapper">
            <input
              id="password"
              type="password"
              name="password"
              autocomplete="new-password"
              placeholder="••••••••"
              required
              minlength="8"
            />
            <button type="button" class="toggle-password" aria-label="Mostrar contraseña">
              <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>
          <span class="helper-text">Debe tener al menos 8 caracteres.</span>
          <span id="err-password" class="field-error"></span>
        </div>
        <div class="form-group">
          <label for="confirmPassword">Confirmar Contraseña</label>
          <div class="password-wrapper">
            <input
              id="confirmPassword"
              type="password"
              name="confirmPassword"
              autocomplete="new-password"
              placeholder="••••••••"
              required
              minlength="8"
            />
            <button type="button" class="toggle-password" aria-label="Mostrar contraseña">
              <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>
          <span id="err-confirmPassword" class="field-error"></span>
        </div>
        <button type="submit" class="login-btn">Registrarse</button>
      </form>
      
      <p class="login-footer">
        ¿Ya tienes cuenta? <a href="/login">Inicia sesión</a>
      </p>

    </div>
  </div>
</BaseLayout>

<style>
  .login-wrapper {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
  }
  .login-card {
    width: 100%;
    max-width: 400px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 2.5rem 2rem;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
  }
  .login-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    font-size: 1.25rem;
    color: #111827;
    margin-bottom: 1.75rem;
    letter-spacing: -0.03em;
  }
  .login-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.4rem;
    letter-spacing: -0.03em;
  }
  .login-subtitle {
    color: #6b7280;
    font-size: 0.9rem;
    margin-bottom: 0;
  }
  .error-container {
    min-height: 1.5rem;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: flex-start;
  }
  .login-error {
    color: #dc2626;
    font-size: 0.875rem;
    font-weight: 500;
    width: 100%;
  }
  .login-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .form-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #374151;
  }
  .form-group input {
    padding: 0.7rem 0.9rem;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 0.95rem;
    color: #111827;
    background: #ffffff;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    font-family: inherit;
  }
  .form-group input:focus {
    border-color: #111827;
    box-shadow: 0 0 0 3px rgba(17,24,39,0.08);
  }
  .login-btn {
    padding: 0.8rem;
    background: #111827;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    margin-top: 0.5rem;
    transition: background 0.15s, transform 0.1s;
    font-family: inherit;
  }
  .login-btn:hover { background: #1f2937; }
  .login-btn:active { transform: scale(0.99); }
  
  .helper-text {
    font-size: 0.75rem;
    color: #6b7280;
    margin-top: 0.15rem;
  }
  .field-error {
    display: block;
    font-size: 0.75rem;
    color: #dc2626;
    margin-top: 0.25rem;
    font-weight: 500;
  }
  .field-error:empty {
    display: none;
  }

  .password-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  .password-wrapper input {
    width: 100%;
    padding-right: 2.5rem;
  }
  .toggle-password {
    position: absolute;
    right: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    color: #9ca3af;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s;
  }
  .toggle-password:hover {
    color: #4b5563;
  }
  .eye-icon {
    width: 20px;
    height: 20px;
  }

  .login-footer {
    text-align: center;
    margin-top: 1.75rem;
    font-size: 0.875rem;
    color: #6b7280;
  }
  .login-footer a {
    color: #111827;
    font-weight: 600;
    text-decoration: none;
    transition: text-decoration 0.2s ease;
  }
  .login-footer a:hover {
    text-decoration: underline;
  }
</style>

<script>
  import { actions, isInputError } from 'astro:actions';

  const toggleBtns = document.querySelectorAll('.toggle-password');
  toggleBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const input = btn.previousElementSibling as HTMLInputElement;
      const icon = btn.querySelector('svg');
      if (!input || !icon) return;

      if (input.type === 'password') {
        input.type = 'text';
        icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
      } else {
        input.type = 'password';
        icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
      }
    });
  });

  const form = document.getElementById('registerForm') as HTMLFormElement;
  const btn = form?.querySelector('.login-btn') as HTMLButtonElement;
  const errGeneral = document.getElementById('err-general');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Limpiar errores previos
      document.querySelectorAll('.field-error').forEach(el => el.textContent = '');
      if (errGeneral) errGeneral.textContent = '';
      
      const prevText = btn.textContent;
      btn.textContent = 'Registrando...';
      btn.style.opacity = '0.7';
      btn.disabled = true;

      const formData = new FormData(form);
      const { data, error } = await actions.register(formData);

      if (error) {
        if (isInputError(error)) {
          for (const [field, messages] of Object.entries(error.fields)) {
            const el = document.getElementById(`err-${field}`);
            if (el) el.textContent = messages[0];
          }
        } else {
          if (errGeneral) {
            errGeneral.textContent = error.message;
          }
        }
        btn.textContent = prevText;
        btn.style.opacity = '1';
        btn.disabled = false;
      } else {
        // Éxito, redirigir
        window.location.href = `/verify-notice?email=${encodeURIComponent(data.email)}`;
      }
    });
  }
</script>
