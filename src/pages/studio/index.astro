---
import StudioLayout from '../../layouts/StudioLayout.astro';
import { db } from '../../db/client.ts';
import { posts as postsTable } from '../../db/schema.ts';
import { eq, desc } from 'drizzle-orm';
import { lucia } from '../../lib/lucia.ts';
import DashboardList from '../../components/studio/DashboardList';

const sessionId = Astro.cookies.get(lucia.sessionCookieName)?.value;
if (!sessionId) return Astro.redirect('/login');
const { user } = await lucia.validateSession(sessionId);
if (!user) return Astro.redirect('/login');

// Cargar todos los posts del autor para el SSR (Hydration initial state)
const rows = await db
  .select({
    id:          postsTable.id,
    title:       postsTable.title,
    slug:        postsTable.slug,
    readingTime: postsTable.readingTime,
    published:   postsTable.published,
    status:      postsTable.status,
    publishedAt: postsTable.publishedAt,
    createdAt:   postsTable.createdAt,
    updatedAt:   postsTable.updatedAt,
  })
  .from(postsTable)
  .where(eq(postsTable.authorId, user.id))
  .orderBy(desc(postsTable.createdAt))
  .limit(50);

const posts = rows.map(row => ({
  id:          row.id,
  title:       row.title,
  slug:        row.slug,
  readingTime: row.readingTime,
  published:   row.published === 1,
  status:      row.status,
  publishedAt: row.publishedAt,
  createdAt:   row.createdAt,
  updatedAt:   row.updatedAt,
}));
---
<StudioLayout title="Dashboard">

  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Dashboard</h1>
      <p class="text-gray-500 text-sm mt-1">Gestiona tus artículos publicados y borradores.</p>
    </div>
    <a href="/studio/escribir" class="inline-flex items-center gap-2 bg-slate-900 text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-slate-800 transition-colors">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M5 12h14"/>
      </svg>
      Nuevo artículo
    </a>
  </div>

  <DashboardList client:load initialPosts={posts} />

</StudioLayout>


