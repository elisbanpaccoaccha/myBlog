---
import StudioLayout from '../../layouts/StudioLayout.astro';
import EditorWYSIWYG from '../../components/studio/EditorWYSIWYG';
import TagSelector from '../../components/studio/TagSelector';
import { actions } from 'astro:actions';
import { db } from '../../db/client.ts';
import { posts as postsTable, tags as tagsTable, postTags } from '../../db/schema.ts';
import { eq, and } from 'drizzle-orm';
import { lucia } from '../../lib/lucia.ts';

// Verificar sesión
const sessionId = Astro.cookies.get(lucia.sessionCookieName)?.value;
if (!sessionId) return Astro.redirect('/login');
const { user } = await lucia.validateSession(sessionId);
if (!user) return Astro.redirect('/login');

// Procesar resultado de publicación si viene desde un redirect
const result = Astro.url.searchParams.get('result');
const slug   = Astro.url.searchParams.get('slug');

// Si hay un ID en la URL, estamos en modo Edición
const editId = Astro.url.searchParams.get('id');
let post = null;
let tags: string[] = [];

if (editId) {
  const postRows = await db
    .select({
      id:          postsTable.id,
      title:       postsTable.title,
      excerpt:     postsTable.excerpt,
      coverImage:  postsTable.coverImage,
      content:     postsTable.content,
      status:      postsTable.status,
    })
    .from(postsTable)
    .where(and(eq(postsTable.id, editId), eq(postsTable.authorId, user.id)))
    .limit(1);

  if (postRows.length > 0) {
    post = postRows[0];
    
    // Cargar tags
    const tagsRows = await db
      .select({
        name: tagsTable.name,
      })
      .from(tagsTable)
      .innerJoin(postTags, eq(tagsTable.id, postTags.tagId))
      .where(eq(postTags.postId, editId));

    tags = tagsRows.map(r => r.name);
  }
}
---
<StudioLayout title={post ? "Editar Post" : "Escribir Post"} hideNav={true}>

  <div id="toast" class="toast">Borrador guardado</div>

  <form method="POST" action={actions.savePost} class="relative" id="write-form">
    {post && <input type="hidden" name="id" value={post.id} />}

    <!-- Sticky Header para Acciones -->
    <div class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-200 px-4 h-16 flex items-center">
      <div class="max-w-[728px] mx-auto w-full flex items-center justify-between">
        <a href="/studio" class="inline-flex items-center gap-2 text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors group">
          <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Volver
        </a>
        <div class="flex items-center gap-3">
          <button type="submit" name="status" value="DRAFT" class="btn btn--ghost text-sm py-1.5 px-3" id="draft-btn">Guardar Borrador</button>
          <button type="button" class="btn btn--primary text-sm py-1.5 px-4" id="open-publish-modal-btn">
            {post?.status === 'PUBLISHED' ? 'Actualizar' : 'Publicar'}
          </button>
        </div>
      </div>
    </div>

    <div class="max-w-[728px] mx-auto py-12 px-4 md:px-0">
      {result === 'ok' && slug && (
        <div class="alert alert--success" role="alert">
          ✅ Artículo guardado correctamente.
          <a href={`/blog/${slug}`} class="alert__link" target="_blank" rel="noopener">Ver artículo →</a>
        </div>
      )}

    <!-- Título Inmersivo -->
    <textarea
      id="post-title"
      name="title"
      class="w-full text-5xl font-bold border-none focus:ring-0 resize-none p-0 bg-transparent placeholder:text-slate-300 mb-8 outline-none leading-tight"
      placeholder="Título"
      required
      rows="1"
      style="overflow: hidden;"
    >{post?.title as string || ''}</textarea>

    <!-- Editor WYSIWYG -->
    <div class="prose prose-lg md:prose-xl max-w-none focus:outline-none mb-12">
      <EditorWYSIWYG client:only="react" initialContent={post?.content as string || ''} />
    </div>

    </div>

    <!-- Modal de Publicación -->
    <div id="publish-modal" class="fixed inset-0 z-[100] flex items-center justify-center hidden">
      <!-- Backdrop -->
      <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity" id="publish-modal-backdrop"></div>
      
      <!-- Panel -->
      <div class="bg-white rounded-2xl shadow-2xl w-full max-w-xl mx-4 relative z-10 transform scale-95 opacity-0 transition-all duration-200" id="publish-modal-panel">
        
        <div class="flex items-center justify-between p-6 border-b border-gray-100">
          <h2 class="text-xl font-bold text-slate-900">Configuración de Publicación</h2>
          <button type="button" id="close-publish-modal-btn" class="text-gray-400 hover:text-gray-600 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>

        <div class="p-6 space-y-6">
          <div>
            <label class="block text-sm font-semibold text-slate-900 mb-2">URL de la Portada</label>
            <input type="url" name="coverImage" value={post?.coverImage as string || ''} placeholder="https://ejemplo.com/imagen.jpg" class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm focus:border-slate-900 focus:ring-1 focus:ring-slate-900 outline-none transition-shadow" />
            <p class="text-xs text-gray-500 mt-1.5">Una imagen atractiva mejora el CTR en redes sociales.</p>
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-900 mb-2">Extracto (SEO)</label>
            <textarea name="excerpt" rows="3" placeholder="Un breve resumen de tu artículo (máx. 160 caracteres)" class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm focus:border-slate-900 focus:ring-1 focus:ring-slate-900 outline-none transition-shadow resize-none">{post?.excerpt as string || ''}</textarea>
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-900 mb-2">Etiquetas</label>
            <TagSelector client:load initialTags={tags} />
          </div>
        </div>

        <div class="p-6 border-t border-gray-100 bg-gray-50 rounded-b-2xl flex justify-end gap-3">
          <button type="button" id="cancel-publish-modal-btn" class="btn btn--ghost text-sm py-2 px-4">Cancelar</button>
          <button type="submit" name="status" value="PUBLISHED" class="btn btn--primary text-sm py-2 px-6 shadow-md" id="publish-btn">
            Confirmar y Publicar ahora
          </button>
        </div>
      </div>
    </div>


  </form>

</StudioLayout>

<script>
  import { actions } from 'astro:actions';
  
  const form = document.getElementById('write-form') as HTMLFormElement;
  const draftBtn = document.getElementById('draft-btn') as HTMLButtonElement;
  const publishBtn = document.getElementById('publish-btn') as HTMLButtonElement;
  const toast = document.getElementById('toast');
  
  // Auto-resize del Título
  const titleTextarea = document.getElementById('post-title') as HTMLTextAreaElement;
  if (titleTextarea) {
    // Resize initial
    titleTextarea.style.height = 'auto';
    titleTextarea.style.height = titleTextarea.scrollHeight + 'px';
    
    // Resize on typing
    titleTextarea.addEventListener('input', function() {
      this.style.height = 'auto';
      this.style.height = this.scrollHeight + 'px';
    });
  }

  // Modal Logic
  const modal = document.getElementById('publish-modal');
  const modalPanel = document.getElementById('publish-modal-panel');
  const openModalBtn = document.getElementById('open-publish-modal-btn');
  const closeModalBtns = [
    document.getElementById('close-publish-modal-btn'),
    document.getElementById('cancel-publish-modal-btn'),
    document.getElementById('publish-modal-backdrop')
  ];

  const toggleModal = (show: boolean) => {
    if (!modal || !modalPanel) return;
    if (show) {
      modal.classList.remove('hidden');
      // trigger reflow
      void modal.offsetWidth;
      modalPanel.classList.remove('scale-95', 'opacity-0');
      modalPanel.classList.add('scale-100', 'opacity-100');
    } else {
      modalPanel.classList.remove('scale-100', 'opacity-100');
      modalPanel.classList.add('scale-95', 'opacity-0');
      setTimeout(() => modal.classList.add('hidden'), 200);
    }
  };

  openModalBtn?.addEventListener('click', () => toggleModal(true));
  closeModalBtns.forEach(btn => btn?.addEventListener('click', () => toggleModal(false)));
  
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    
    // Identificar qué botón disparó el submit
    const submitter = (e as SubmitEvent).submitter as HTMLButtonElement;
    const isDraft = submitter?.value === 'DRAFT';
    
    const formData = new FormData(form);
    formData.set('status', isDraft ? 'DRAFT' : 'PUBLISHED');
    
    // Estado de carga en los botones
    const targetBtn = isDraft ? draftBtn : publishBtn;
    const originalText = targetBtn.textContent;
    targetBtn.textContent = isDraft ? 'Guardando...' : 'Publicando...';
    draftBtn.disabled = true;
    publishBtn.disabled = true;
    
    const { data, error } = await actions.savePost(formData);
    
    if (targetBtn) targetBtn.textContent = originalText;
    draftBtn.disabled = false;
    publishBtn.disabled = false;
    
    if (!error) {
      if (isDraft) {
        // Inject ID so subsequent saves update the same draft
        if (!form.querySelector('input[name="id"]') && data?.postId) {
          const idInput = document.createElement('input');
          idInput.type = 'hidden';
          idInput.name = 'id';
          idInput.value = data.postId;
          form.appendChild(idInput);
          
          // Update URL without reloading
          window.history.replaceState(null, '', `?id=${data.postId}`);
        }
        
        toast?.classList.add('show');
        setTimeout(() => toast?.classList.remove('show'), 3000);
      } else {
        // Redirigir mostrando éxito
        window.location.href = `/studio/escribir?result=ok&slug=${data?.slug}`;
      }
    } else {
      alert(error.message || 'Error al procesar la solicitud');
    }
  });
</script>

<style>
  .write-header {
    margin-bottom: 2rem;
  }
  .write-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: #111827;
    letter-spacing: -0.03em;
    margin-bottom: 0.25rem;
  }
  .write-subtitle {
    color: #6b7280;
    font-size: 0.9rem;
  }
  .alert {
    padding: 0.85rem 1.25rem;
    border-radius: 10px;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .alert--success {
    background: #f0fdf4;
    color: #166534;
    border: 1px solid #bbf7d0;
  }
  .alert__link {
    color: #166534;
    font-weight: 600;
    text-decoration: underline;
  }
  .write-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e5e7eb;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 1.4rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, transform 0.1s;
    text-decoration: none;
    border: none;
    font-family: inherit;
  }
  .btn--primary { background: #111827; color: #fff; }
  .btn--primary:hover { background: #1f2937; }
  .btn--primary:active { transform: scale(0.98); }
  .btn--ghost:hover { background: #f9fafb; }
  
  .toast {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: #111827;
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: opacity 0.3s, transform 0.3s;
    z-index: 100;
  }
  .toast.show {
    opacity: 1;
    transform: translateY(0);
  }
</style>
