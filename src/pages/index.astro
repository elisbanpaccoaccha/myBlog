---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Home">
  <section style="text-align: center; padding: 4rem 1rem; background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%); border-radius: 12px; margin-top: 2rem; border: 1px solid #eaeaea;">
    <h1 style="font-size: 3.5rem; margin-bottom: 1rem; letter-spacing: -0.05em; line-height: 1.1;">Welcome to MyBlog</h1>
    <p style="font-size: 1.25rem; color: #555; margin-bottom: 2rem; max-width: 600px; margin-left: auto; margin-right: auto;">
      A modern, fast, and beautiful blog powered by Astro, Turso DB, and React Islands.
    </p>
    <a href="/blog" style="display: inline-block; padding: 0.75rem 2rem; background: #0070f3; color: #fff; text-decoration: none; border-radius: 999px; font-weight: 600; font-size: 1.1rem; transition: transform 0.2s, box-shadow 0.2s;">
      Start Reading
    </a>
  </section>
</BaseLayout>
