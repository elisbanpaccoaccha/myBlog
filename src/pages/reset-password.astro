---
import BaseLayout from '../layouts/BaseLayout.astro';
import { lucia } from '../lib/lucia';

// Si el usuario ya está logueado, redirigir al panel
const sessionId = Astro.cookies.get(lucia.sessionCookieName)?.value;
if (sessionId) {
  const { session } = await lucia.validateSession(sessionId);
  if (session) {
    return Astro.redirect('/studio');
  }
}

// Obtener el token de la URL (ej: /reset-password?token=abc...)
const token = Astro.url.searchParams.get('token');

if (!token) {
  return Astro.redirect('/login');
}
---

<BaseLayout title="Nueva contraseña">
  <div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
      <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
        Nueva contraseña
      </h2>
      <p class="mt-2 text-center text-sm text-gray-600">
        Ingresa tu nueva contraseña para acceder a tu cuenta.
      </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
      <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10 border border-gray-100 relative overflow-hidden">
        
        <!-- Estado de Éxito (Oculto por defecto) -->
        <div id="success-state" class="hidden flex-col items-center justify-center text-center py-4 opacity-0 transition-opacity duration-500">
          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">¡Contraseña actualizada!</h3>
          <p class="text-sm text-slate-500 mb-6">Tu contraseña ha sido cambiada exitosamente. Ya puedes acceder a tu cuenta.</p>
          <a href="/login" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-slate-900 hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-900 transition-colors cursor-pointer">
            Ir a Iniciar Sesión
          </a>
        </div>

        <!-- Mensaje de error simple -->
        <p id="error-alert" class="hidden text-sm text-red-600 font-medium text-center mb-4 transition-all"></p>

        <!-- Formulario de reseteo -->
        <form id="reset-form" class="space-y-5 transition-opacity duration-300">
          <input type="hidden" name="token" value={token} />
          
          <div>
            <label for="password" class="block text-sm font-medium text-gray-700 mb-1">
              Nueva contraseña
            </label>
            <input
              id="password"
              name="password"
              type="password"
              required
              minlength="8"
              class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-900 focus:border-slate-900 sm:text-sm transition-colors"
            />
          </div>

          <div>
            <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-1">
              Confirmar contraseña
            </label>
            <input
              id="confirmPassword"
              name="confirmPassword"
              type="password"
              required
              minlength="8"
              class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-900 focus:border-slate-900 sm:text-sm transition-colors"
            />
            <p class="mt-2 text-xs text-gray-500">Debe coincidir con la contraseña anterior y tener al menos 8 caracteres.</p>
          </div>

          <div class="pt-2">
            <button
              type="submit"
              id="submit-btn"
              class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-slate-900 hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-900 transition-colors cursor-pointer"
            >
              Restablecer contraseña
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { actions } from 'astro:actions';

  const form = document.getElementById('reset-form') as HTMLFormElement;
  const errorAlert = document.getElementById('error-alert') as HTMLParagraphElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successState = document.getElementById('success-state') as HTMLDivElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorAlert.classList.add('hidden');
    errorAlert.textContent = '';
    
    // Validación de coincidencia en el frontend para respuesta inmediata
    const formData = new FormData(form);
    if (formData.get('password') !== formData.get('confirmPassword')) {
      errorAlert.textContent = 'Las contraseñas no coinciden.';
      errorAlert.classList.remove('hidden');
      return;
    }
    
    const originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Actualizando...';
    btn.classList.add('opacity-75', 'cursor-not-allowed');

    const { error } = await actions.resetPassword(formData);

    if (error) {
      errorAlert.textContent = error.message;
      errorAlert.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = originalText;
      btn.classList.remove('opacity-75', 'cursor-not-allowed');
    } else {
      // Transición suave al estado de éxito
      form.classList.add('opacity-0');
      setTimeout(() => {
        form.classList.add('hidden');
        successState.classList.remove('hidden');
        // Pequeño delay para permitir que el display block tome efecto antes de la opacidad
        setTimeout(() => {
          successState.classList.remove('opacity-0');
          successState.classList.add('opacity-100', 'flex');
        }, 50);
      }, 300);
    }
  });
</script>
