---
import BaseLayout from '../layouts/BaseLayout.astro';
import { lucia } from '../lib/lucia';

// Si el usuario ya está logueado, redirigir al panel
const sessionId = Astro.cookies.get(lucia.sessionCookieName)?.value;
if (sessionId) {
  const { session } = await lucia.validateSession(sessionId);
  if (session) {
    return Astro.redirect('/studio');
  }
}
---

<BaseLayout title="Recuperar contraseña">
  <div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
      <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
        Recuperar contraseña
      </h2>
      <p class="mt-2 text-center text-sm text-gray-600">
        Ingresa tu correo o usuario y te enviaremos un enlace.
      </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
      <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10 border border-gray-100">
        
        <!-- Mensaje de error en texto simple -->
        <p id="error-alert" class="hidden text-sm text-red-600 font-medium text-center mb-4 transition-all"></p>

        <form id="forgot-form" class="space-y-6">
          
          <!-- Estado de Éxito (Oculto por defecto) -->
          <div id="success-state" class="hidden flex-col items-center justify-center text-center py-2 opacity-0 transition-opacity duration-500">
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
              <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">¡Correo enviado!</h3>
            <p class="text-sm text-slate-500 mb-2">Si la cuenta existe, hemos enviado un enlace que expirará en 3 minutos.</p>
            <p class="text-sm text-slate-500">Revisa tu bandeja de entrada.</p>
          </div>

          <div id="input-group" class="transition-opacity duration-300">
            <label for="email" class="block text-sm font-medium text-gray-700">
              Correo electrónico o Usuario
            </label>
            <div class="mt-1">
              <input
                id="email"
                name="email"
                type="text"
                required
                class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-900 focus:border-slate-900 sm:text-sm transition-colors"
              />
            </div>
          </div>

          <div>
            <button
              type="submit"
              id="submit-btn"
              class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-slate-900 hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-900 transition-colors cursor-pointer"
            >
              Enviar enlace de recuperación
            </button>
            <p id="countdown-text" class="hidden text-center mt-3 text-xs text-gray-500 font-medium">Podrás reenviar en <span id="timer">180</span>s</p>
          </div>
          
          <div class="text-center mt-4">
            <a href="/login" class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">
              Volver al inicio de sesión
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { actions } from 'astro:actions';

  const form = document.getElementById('forgot-form') as HTMLFormElement;
  const errorAlert = document.getElementById('error-alert') as HTMLParagraphElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const inputGroup = document.getElementById('input-group') as HTMLDivElement;
  const successState = document.getElementById('success-state') as HTMLDivElement;
  const countdownText = document.getElementById('countdown-text') as HTMLParagraphElement;
  const timerSpan = document.getElementById('timer') as HTMLSpanElement;

  let countdownInterval: ReturnType<typeof setInterval>;

  const startCountdown = () => {
    let secondsLeft = 180; // 3 minutos
    
    btn.disabled = true;
    btn.classList.add('opacity-50', 'cursor-not-allowed');
    btn.classList.remove('hover:bg-slate-800');
    countdownText.classList.remove('hidden');
    
    countdownInterval = setInterval(() => {
      secondsLeft--;
      timerSpan.textContent = secondsLeft.toString();
      
      if (secondsLeft <= 0) {
        clearInterval(countdownInterval);
        btn.disabled = false;
        btn.classList.remove('opacity-50', 'cursor-not-allowed');
        btn.classList.add('hover:bg-slate-800');
        countdownText.classList.add('hidden');
        btn.textContent = 'Reenviar enlace';
      }
    }, 1000);
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorAlert.classList.add('hidden');
    errorAlert.textContent = '';

    const originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Enviando...';
    btn.classList.add('opacity-75', 'cursor-not-allowed');

    const formData = new FormData(form);
    const { error } = await actions.forgotPassword(formData);

    if (error) {
      errorAlert.textContent = error.message;
      errorAlert.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = originalText;
      btn.classList.remove('opacity-75', 'cursor-not-allowed');
    } else {
      // Ocultar input y alert
      errorAlert.classList.add('hidden');
      inputGroup.classList.add('hidden');
      
      // Mostrar estado de éxito central
      successState.classList.remove('hidden');
      setTimeout(() => {
        successState.classList.remove('opacity-0');
        successState.classList.add('opacity-100', 'flex');
      }, 50);

      btn.textContent = 'Enlace enviado';
      startCountdown(); 
    }
  });
</script>
