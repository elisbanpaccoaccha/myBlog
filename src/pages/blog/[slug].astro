---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { db } from '../../db/client.ts';
import { posts as postsTable, users as usersTable, postTags, tags, bookmarks, comments, likes } from '../../db/schema.ts';
import { eq, sql, and } from 'drizzle-orm';
import { lucia } from '../../lib/lucia';
import Reader from '../../components/studio/Reader.tsx';
import BookmarkButton from '../../components/blog/BookmarkButton.tsx';
import CommentsSection from '../../components/blog/CommentsSection.tsx';
import LikeButton from '../../components/blog/LikeButton.tsx';
import ShareButton from '../../components/blog/ShareButton';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

// ─── Obtener el usuario actual para verificar permisos ────────────────────────
const sessionId = Astro.cookies.get(lucia.sessionCookieName)?.value;
let currentUserId: string | null = null;
if (sessionId) {
  const { user } = await lucia.validateSession(sessionId);
  if (user) currentUserId = user.id;
}

// ─── Consulta por slug ───────────────────────────────────────────────────────
const rows = await db
  .select({
    id:          postsTable.id,
    title:       postsTable.title,
    slug:        postsTable.slug,
    excerpt:     postsTable.excerpt,
    coverImage:  postsTable.coverImage,
    content:     postsTable.content,
    readingTime: postsTable.readingTime,
    publishedAt: postsTable.publishedAt,
    status:      postsTable.status,
    authorId:    postsTable.authorId,
    authorUsername: usersTable.username,
    authorDisplayName: usersTable.displayName,
    authorAvatar: usersTable.avatarUrl,
    tags:        sql<string | null>`GROUP_CONCAT(${tags.name}, ',')`,
  })
  .from(postsTable)
  .leftJoin(usersTable, eq(postsTable.authorId, usersTable.id))
  .leftJoin(postTags, eq(postTags.postId, postsTable.id))
  .leftJoin(tags, eq(tags.id, postTags.tagId))
  .where(eq(postsTable.slug, slug))
  .groupBy(postsTable.id)
  .limit(1);

if (rows.length === 0) {
  return Astro.redirect('/404');
}

const row  = rows[0]!;

// Sistema de Vistas Únicas
const viewCookieName = `viewed_${row.id}`;
const hasViewed = Astro.cookies.has(viewCookieName);

if (!hasViewed) {
  // Incrementar el contador de vistas en la base de datos
  await db.update(postsTable)
    .set({ viewCount: sql`${postsTable.viewCount} + 1` })
    .where(eq(postsTable.id, row.id));
    
  // Guardar la cookie en el navegador por 24 horas
  Astro.cookies.set(viewCookieName, 'true', {
    path: '/',
    maxAge: 60 * 60 * 24, // 24 horas
    httpOnly: true, // Invisible para Javascript del cliente (más seguro)
    secure: import.meta.env.PROD, // Solo por HTTPS en producción
    sameSite: 'lax',
  });
}

// Filtro de privacidad: Si es borrador, solo el autor puede verlo
if (row.status === 'DRAFT' && row.authorId !== currentUserId) {
  return Astro.redirect('/404');
}
const post = {
  id:          row.id,
  title:       row.title,
  slug:        row.slug,
  excerpt:     row.excerpt ?? '',
  coverImage:  row.coverImage ?? '',
  content:     row.content,
  readingTime: row.readingTime,
  publishedAt: new Date(row.publishedAt || 0),
  author:      row.authorDisplayName || row.authorUsername || 'Admin',
  authorAvatar: row.authorAvatar,
  tags:        row.tags ? row.tags.split(',').filter(Boolean) : [],
};

// Eliminado el renderizador AST custom, delegamos a Reader.tsx
const formattedDate = post.publishedAt.toLocaleDateString('es-ES', {
  year: 'numeric', month: 'long', day: 'numeric',
});

let initialBookmarked = false;
let initialCommentCount = 0;
let initialLikeCount = 0;
let initialUserLikeCount = 0;

if (post.id) {
  const [{ count }] = await db
    .select({ count: sql<number>`count(*)` })
    .from(comments)
    .where(eq(comments.postId, post.id));
  initialCommentCount = count;

  const [{ totalLikes }] = await db
    .select({ totalLikes: sql<number>`sum(${likes.count})` })
    .from(likes)
    .where(eq(likes.postId, post.id));
  initialLikeCount = totalLikes || 0;
}

if (currentUserId && post.id) {
  const [bkmk] = await db
    .select()
    .from(bookmarks)
    .where(and(eq(bookmarks.userId, currentUserId), eq(bookmarks.postId, post.id)))
    .limit(1);
  initialBookmarked = !!bkmk;

  const [lk] = await db
    .select()
    .from(likes)
    .where(and(eq(likes.userId, currentUserId), eq(likes.postId, post.id)))
    .limit(1);
  initialUserLikeCount = lk ? lk.count : 0;
}
---
<BaseLayout
  title={post.title}
  description={post.excerpt || post.title}
  image={post.coverImage || '/favicon.svg'}
  type="article"
>
  <article class="article-layout">

    <!-- ─── Cabecera del artículo ──────────────────────── -->
    <header class="article-header">
      <h1 class="article-title">{post.title}</h1>

      <div class="article-meta">
        {post.authorAvatar ? (
          <img src={post.authorAvatar} alt={post.author} class="article-meta__avatar-img" />
        ) : (
          <div class="article-meta__avatar" aria-hidden="true">
            {post.author.charAt(0).toUpperCase()}
          </div>
        )}
        <div class="article-meta__info">
          <span class="article-meta__author">{post.author}</span>
          <span class="article-meta__details">
            {post.readingTime} min de lectura · <time datetime={post.publishedAt.toISOString()}>{formattedDate}</time>
          </span>
        </div>
      </div>
    </header>

    <!-- ─── Línea de acciones (estilo Medium: aplausos, comentarios, etc.) -->
    <div class="article-actions" role="toolbar">
      <div class="article-actions__left">
        <LikeButton client:load postId={post.id} initialLikeCount={initialLikeCount} initialUserLikeCount={initialUserLikeCount} />
        
        <a href="#comments" class="action-btn flex items-center justify-center gap-1.5 group relative px-1 rounded-full transition-colors" style="width: auto; min-width: 36px;" aria-label="Ver comentarios">
          <svg class="text-[#6b6b6b] group-hover:text-[#1a1a1a] transition-colors" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
          </svg>
          {initialCommentCount > 0 && <span class="text-[13px] font-medium text-[#6b6b6b] group-hover:text-[#1a1a1a] pr-1">{initialCommentCount}</span>}
        </a>
      </div>
      <div class="article-actions__right">
        <BookmarkButton client:load postId={post.id} initialBookmarked={initialBookmarked} />
        <ShareButton client:load title={post.title} />
      </div>
    </div>

    <!-- ─── Imagen de portada ──────────────────────────────────────────── -->
    {post.coverImage && (
      <figure class="article-cover">
        <img src={post.coverImage} alt={post.title} />
      </figure>
    )}

    <!-- ─── Cuerpo del artículo ───────────────────────────────────────── -->
    <div class="article-body">
      <Reader content={post.content} client:load />
    </div>

    <!-- ─── Etiquetas ────────────────────────────────────────────────── -->
    {post.tags.length > 0 && (
      <div class="article-tags">
        {post.tags.map(tag => (
          <a href={`/blog?tag=${tag}`} class="article-tag">{tag}</a>
        ))}
      </div>
    )}

    <!-- ─── Sección de Comentarios ───────────────────────────────────── -->
    <CommentsSection client:load postId={post.id} commentCount={initialCommentCount} currentUserId={currentUserId} />

    <!-- ─── Tracker de Lecturas ──────────────────────────────────────── -->
    <div id="read-tracker-sentinel" data-post-id={post.id} style="height: 1px; width: 100%;"></div>

  </article>
</BaseLayout>

<script>
  // Script para Trackear Lecturas (Reads)
  document.addEventListener('DOMContentLoaded', () => {
    const sentinel = document.getElementById('read-tracker-sentinel');
    if (!sentinel) return;

    const postId = sentinel.getAttribute('data-post-id');
    const startTime = Date.now();
    let hasBeenRead = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !hasBeenRead) {
          const timeSpent = Date.now() - startTime;
          // Si pasó más de 10 segundos leyendo y scrolleó hasta abajo
          if (timeSpent >= 10000) {
            hasBeenRead = true;
            fetch('/api/posts/read', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ postId })
            }).catch(console.error);
            observer.disconnect();
          }
        }
      });
    }, { threshold: 0.1 });

    observer.observe(sentinel);

    // En caso de que el usuario llegue abajo muy rápido, re-chequeamos al mover el mouse o hacer scroll
    const checkLater = () => {
      if (hasBeenRead) return;
      const rect = sentinel.getBoundingClientRect();
      const isVisible = (rect.top <= (window.innerHeight || document.documentElement.clientHeight));
      const timeSpent = Date.now() - startTime;
      
      if (isVisible && timeSpent >= 10000) {
        hasBeenRead = true;
        fetch('/api/posts/read', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ postId })
        }).catch(console.error);
        
        window.removeEventListener('scroll', checkLater);
        window.removeEventListener('mousemove', checkLater);
      }
    };

    window.addEventListener('scroll', checkLater, { passive: true });
    window.addEventListener('mousemove', checkLater, { passive: true });
  });
</script>

<style>
  .article-layout {
    max-width:  728px;
    margin:     0 auto;
    padding:    2.5rem 1.25rem 5rem;
  }

  /* ─── Cabecera ─────────────────────────────────────────────────────── */
  .article-header { margin-bottom: 1.5rem; }
  .article-title {
    font-family:    Georgia, 'Times New Roman', serif;
    font-size:      clamp(1.75rem, 5vw, 2.5rem);
    font-weight:    700;
    line-height:    1.2;
    color:          #1a1a1a;
    letter-spacing: -0.02em;
    margin-bottom:  1rem;
  }

  /* Meta: avatar + autor + fecha */
  .article-meta {
    display:     flex;
    align-items: center;
    gap:         0.75rem;
  }
  .article-meta__avatar {
    width:          42px;
    height:         42px;
    border-radius:  50%;
    background:     #1a1a1a;
    color:          #fff;
    font-size:      1rem;
    font-weight:    700;
    display:        flex;
    align-items:    center;
    justify-content: center;
    flex-shrink:    0;
  }
  .article-meta__avatar-img {
    width:          42px;
    height:         42px;
    border-radius:  50%;
    object-fit:     cover;
    flex-shrink:    0;
  }
  .article-meta__info {
    display:        flex;
    flex-direction: column;
    gap:            0.1rem;
  }
  .article-meta__author {
    font-weight: 600;
    font-size:   0.95rem;
    color:       #1a1a1a;
  }
  .article-meta__details {
    font-size: 0.85rem;
    color:     #6b6b6b;
  }

  /* ─── Barra de acciones (estilo Medium) ─────────────────────────────── */
  .article-actions {
    display:         flex;
    justify-content: space-between;
    align-items:     center;
    padding:         0.75rem 0;
    border-top:      1px solid #e6e6e6;
    border-bottom:   1px solid #e6e6e6;
    margin-bottom:   2rem;
  }
  .article-actions__left,
  .article-actions__right {
    display:     flex;
    align-items: center;
    gap:         0.5rem;
  }
  .action-btn {
    display:       flex;
    align-items:   center;
    justify-content: center;
    width:         36px;
    height:        36px;
    border:        none;
    background:    transparent;
    color:         #6b6b6b;
    cursor:        pointer;
    border-radius: 50%;
    transition:    background 0.15s, color 0.15s;
  }
  .action-btn:hover {
    background: #f2f2f2;
    color:      #1a1a1a;
  }

  /* ─── Portada ────────────────────────────────────────────────────── */
  .article-cover {
    margin:   0 0 2.5rem;
    border-radius: 4px;
    overflow: hidden;
  }
  .article-cover img {
    width:   100%;
    height:  auto;
    display: block;
  }

  /* ─── Cuerpo del artículo ────────────────────────────────────────── */
  .article-body { margin-bottom: 2.5rem; }

  /* ─── Etiquetas ──────────────────────────────────────────────────── */
  .article-tags {
    display:    flex;
    gap:        0.5rem;
    flex-wrap:  wrap;
    padding-top: 2rem;
    border-top: 1px solid #e6e6e6;
  }
  .article-tag {
    font-size:     0.83rem;
    font-weight:   500;
    color:         #6b6b6b;
    background:    #f2f2f2;
    padding:       0.3rem 0.75rem;
    border-radius: 999px;
    transition:    background 0.12s, color 0.12s;
  }
  .article-tag:hover {
    background: #e6e6e6;
    color:      #1a1a1a;
  }
</style>
