    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.1",
